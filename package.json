{
  "name": "atpdev-monorepo",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/core/*",
    "apps/subdomains/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/core/portal && npm run build --workspace=apps/core/admin && npm run build --workspace=apps/subdomains/web-apps/chamba && npm run build --workspace=apps/subdomains/web-apps/sorteos && npm run build --workspace=apps/subdomains/web-apps/descargador && npm run build --workspace=apps/subdomains/web-apps/interactivo-magic && npm run build --workspace=apps/subdomains/web-apps/perusabor && npm run build --workspace=apps/subdomains/web-apps/lectorqr && npm run build --workspace=apps/subdomains/web-apps/dni-scanner && npm run build --workspace=apps/subdomains/web-apps/masteratpdf",
    "build:portal": "npm run build --workspace=apps/core/portal",
    "build:admin": "npm run build --workspace=apps/core/admin",
    "build:chamba": "npm run build --workspace=apps/subdomains/web-apps/chamba",
    "build:sorteos": "npm run build --workspace=apps/subdomains/web-apps/sorteos",
    "build:descargador": "npm run build --workspace=apps/subdomains/web-apps/descargador",
    "build:descargas": "npm run build:descargador",
    "build:magic": "npm run build --workspace=apps/subdomains/web-apps/interactivo-magic",
    "build:perusabor": "npm run build --workspace=apps/subdomains/web-apps/perusabor",
    "build:lectorqr": "npm run build --workspace=apps/subdomains/web-apps/lectorqr",
    "build:dni": "npm run build --workspace=apps/subdomains/web-apps/dni-scanner",
    "build:masteratpdf": "npm run build --workspace=apps/subdomains/web-apps/masteratpdf",
    "dev": "turbo run dev --continue=always",
    "dev:portal": "npm run dev --workspace=apps/core/portal -- -p 3000",
    "dev:admin": "npm run dev --workspace=apps/core/admin",
    "dev:chamba": "npm run dev --workspace=apps/subdomains/web-apps/chamba -- -p 3005",
    "dev:sorteos": "npm run dev --workspace=apps/subdomains/web-apps/sorteos",
    "dev:descargador": "npm run dev --workspace=apps/subdomains/web-apps/descargador",
    "dev:descargas": "npm run dev:descargador",
    "dev:magic": "npm run dev --workspace=apps/subdomains/web-apps/interactivo-magic",
    "dev:perusabor": "npm run dev --workspace=apps/subdomains/web-apps/perusabor",
    "dev:lectorqr": "npm run dev --workspace=apps/subdomains/web-apps/lectorqr -- -p 3010",
    "dev:dni": "npm run dev --workspace=apps/subdomains/web-apps/dni-scanner",
    "dev:masteratpdf": "npm run dev --workspace=apps/subdomains/web-apps/masteratpdf -- -p 3011",
    "sync:magic": "npm run build:mobile --workspace=apps/subdomains/web-apps/interactivo-magic",
    "android:magic": "npm run android --workspace=apps/subdomains/web-apps/interactivo-magic",
    "sync:dni": "npm run build:mobile --workspace=apps/subdomains/web-apps/dni-scanner",
    "android:dni": "npm run android --workspace=apps/subdomains/web-apps/dni-scanner",
    "test": "npm test --workspace=packages/database",
    "test:verify": "npm run test:verify --workspace=packages/database",
    "lint": "npm run lint --workspace=apps/core/portal && npm run lint --workspace=apps/core/admin && npm run lint --workspace=apps/subdomains/web-apps/chamba",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "prettier": "^3.2.5",
    "turbo": "^2.10.9"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-musl": "^4.0.0"
  }
}
