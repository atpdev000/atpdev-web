{
  "name": "atpdev-monorepo",
  "private": true,
  "packageManager": "npm@11.6.1",
  "workspaces": [
    "apps/core/*",
    "apps/subdomains/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=apps/core/portal && npm run build --workspace=apps/core/admin && npm run build --workspace=apps/subdomains/web-apps/chamba && npm run build --workspace=apps/subdomains/web-apps/sorteos && npm run build --workspace=apps/subdomains/web-apps/descargador",
    "build:portal": "npm run build --workspace=apps/core/portal",
    "build:admin": "npm run build --workspace=apps/core/admin",
    "build:chamba": "npm run build --workspace=apps/subdomains/web-apps/chamba",
    "build:sorteos": "npm run build --workspace=apps/subdomains/web-apps/sorteos",
    "build:descargador": "npm run build --workspace=apps/subdomains/web-apps/descargador",
    "dev": "turbo run dev --continue=always",
    "dev:portal": "npm run dev --workspace=apps/core/portal -- -p 3000",
    "dev:admin": "npm run dev --workspace=apps/core/admin -- -p 3001",
    "dev:chamba": "npm run dev --workspace=apps/subdomains/web-apps/chamba -- -p 3005",
    "dev:sorteos": "npm run dev --workspace=apps/subdomains/web-apps/sorteos",
    "dev:descargador": "npm run dev --workspace=apps/subdomains/web-apps/descargador -- -p 3007",
    "test": "npm test --workspace=packages/database",
    "test:verify": "npm run test:verify --workspace=packages/database",
    "lint": "npm run lint --workspace=apps/core/portal && npm run lint --workspace=apps/core/admin && npm run lint --workspace=apps/subdomains/web-apps/chamba",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "lightningcss": "^1.33.0",
    "prettier": "^3.2.5",
    "turbo": "^2.10.9"
  },
  "optionalDependencies": {
    "@tailwindcss/oxide-linux-x64-gnu": "^4.0.0",
    "@tailwindcss/oxide-linux-x64-musl": "^4.0.0"
  }
}
